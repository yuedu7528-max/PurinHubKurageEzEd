-- ==========================================
-- 2. GUIドラッグ処理（マウス・タッチ対応）
-- ==========================================
do
	local dragging = false
	local dragInput: InputObject? = nil
	local dragStart: Vector3 = Vector3.zero
	local startPos: UDim2 = mainFrame.Position

	local function updateDrag(input: InputObject)
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end

	dragHeader.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = mainFrame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	dragHeader.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input: InputObject)
		if dragging and input == dragInput then
			updateDrag(input)
		end
	end)
end

-- ==========================================
-- 3. プレイヤー一覧・解除・キー設定ロジック
-- ==========================================
local function refreshKeyButtons()
	clearButton.Text = string.format("解除 [%s]", unlockKey.Name)
	if isBindingKey then
		bindButton.Text = "キー押下..."
		bindButton.BackgroundColor3 = Color3.fromRGB(210, 140, 30)
	else
		bindButton.Text = "キー変更"
		bindButton.BackgroundColor3 = Color3.fromRGB(60, 65, 85)
	end
end

local function updateStatusText()
	if isEnabled and targetPlayer then
		statusLabel.Text = "ロック中: " .. targetPlayer.DisplayName
	else
		statusLabel.Text = "ロック中: なし"
	end
end

local function refreshPlayerList()
	for _, child in ipairs(scrollingFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer then
			local btn = Instance.new("TextButton")
			btn.Name = plr.Name
			btn.Size = UDim2.new(1, -4, 0, 32)
			btn.BackgroundColor3 = (targetPlayer == plr and isEnabled)
				and Color3.fromRGB(45, 115, 200)
				or Color3.fromRGB(40, 40, 48)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.Font = Enum.Font.Gotham
			btn.TextSize = 13
			btn.Text = string.format("%s (@%s)", plr.DisplayName, plr.Name)
			btn.Parent = scrollingFrame

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 6)
			corner.Parent = btn

			btn.MouseButton1Click:Connect(function()
				targetPlayer = plr
				isEnabled = true
				updateStatusText()
				refreshPlayerList()
			end)
		end
	end
end

local function unlockTarget()
	if not isEnabled and not targetPlayer then
		return
	end
	isEnabled = false
	targetPlayer = nil
	updateStatusText()
	refreshPlayerList()
end

toggleButton.MouseButton1Click:Connect(function()
	mainFrame.Visible = not mainFrame.Visible
	toggleButton.Text = mainFrame.Visible and "ターゲット選択 ▼" or "ターゲット選択 ▶"
end)

clearButton.MouseButton1Click:Connect(unlockTarget)

bindButton.MouseButton1Click:Connect(function()
	isBindingKey = not isBindingKey
	refreshKeyButtons()
end)

UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	-- キー設定待機中の処理
	if isBindingKey then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
				unlockKey = input.KeyCode
			end
			isBindingKey = false
			refreshKeyButtons()
		end
		return
	end

	if gameProcessed then
		return
	end

	if input.KeyCode == unlockKey then
		unlockTarget()
	end
end)

Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(function(removingPlayer)
	if targetPlayer == removingPlayer then
		unlockTarget()
	end
	task.defer(refreshPlayerList)
end)

refreshKeyButtons()
refreshPlayerList()

-- ==========================================
-- 4. 強力なカメラ＆キャラクター追従
-- ==========================================
RunService:BindToRenderStep("StrongPlayerLock", Enum.RenderPriority.Camera.Value + 1, function()
	if not isEnabled or not targetPlayer then
		return
	end

	local targetChar = targetPlayer.Character
	if not targetChar then
		return
	end

	local targetPart = targetChar:FindFirstChild(AIM_PART)
		or targetChar:FindFirstChild("HumanoidRootPart")
		or targetChar.PrimaryPart

	if not targetPart or not targetPart:IsA("BasePart") then
		return
	end

	local targetPos = targetPart.Position
	local camPos = camera.CFrame.Position
	local desiredCamCFrame = CFrame.lookAt(camPos, targetPos)

	if LOCK_STRENGTH >= 1.0 then
		camera.CFrame = desiredCamCFrame
	else
		camera.CFrame = camera.CFrame:Lerp(desiredCamCFrame, LOCK_STRENGTH)
	end

	if ROTATE_CHARACTER then
		local myChar = localPlayer.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if myRoot and myRoot:IsA("BasePart") then
			local flatTarget = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
			myRoot.CFrame = CFrame.lookAt(myRoot.Position, flatTarget)
		end
	end
end)
