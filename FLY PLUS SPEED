	inputBox.TextColor3 = Color3.new(1, 1, 1)
	inputBox.Font = Enum.Font.GothamBold
	inputBox.TextSize = 11
	inputBox.ClearTextOnFocus = false
	inputBox.BorderSizePixel = 0
	inputBox.Parent = container
	Instance.new("UICorner", inputBox).CornerRadius = UDim.new(0, 5)

	local plusBtn = Instance.new("TextButton")
	plusBtn.Size = UDim2.new(0, 24, 0, 24)
	plusBtn.Position = UDim2.new(1, -28, 0, 4)
	plusBtn.BackgroundColor3 = Color3.fromRGB(55, 60, 76)
	plusBtn.Text = "+"
	plusBtn.TextColor3 = Color3.new(1, 1, 1)
	plusBtn.Font = Enum.Font.GothamBold
	plusBtn.TextSize = 14
	plusBtn.BorderSizePixel = 0
	plusBtn.Parent = container
	Instance.new("UICorner", plusBtn).CornerRadius = UDim.new(0, 5)

	local track = Instance.new("TextButton")
	track.Size = UDim2.new(1, -16, 0, 22)
	track.Position = UDim2.new(0, 8, 0, 40)
	track.BackgroundColor3 = Color3.fromRGB(22, 24, 32)
	track.Text = ""
	track.AutoButtonColor = false
	track.BorderSizePixel = 0
	track.Parent = container
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(80, 145, 255)
	fill.BorderSizePixel = 0
	fill.Parent = track
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local hintLabel = Instance.new("TextLabel")
	hintLabel.Size = UDim2.new(1, -12, 1, 0)
	hintLabel.Position = UDim2.new(0, 6, 0, 0)
	hintLabel.BackgroundTransparency = 1
	hintLabel.Text = "Drag or Scroll (0-500)"
	hintLabel.TextColor3 = Color3.fromRGB(165, 175, 195)
	hintLabel.Font = Enum.Font.Gotham
	hintLabel.TextSize = 10
	hintLabel.TextXAlignment = Enum.TextXAlignment.Center
	hintLabel.Parent = track

	local currentVal = math.clamp(initialValue, MIN_SPEED, MAX_SPEED)
	local dragging = false

	local function setValue(val, fromInput)
		currentVal = math.clamp(math.floor(val + 0.5), MIN_SPEED, MAX_SPEED)
		local ratio = (currentVal - MIN_SPEED) / (MAX_SPEED - MIN_SPEED)
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		if not fromInput then
			inputBox.Text = tostring(currentVal)
		end
		onChanged(currentVal)
	end

	local function updateFromX(xPos)
		local absPos = track.AbsolutePosition.X
		local absSize = track.AbsoluteSize.X
		if absSize <= 0 then return end
		local ratio = math.clamp((xPos - absPos) / absSize, 0, 1)
		setValue(MIN_SPEED + ratio * (MAX_SPEED - MIN_SPEED), false)
	end

	trackConn(track.MouseButton1Down:Connect(function(x)
		dragging = true
		updateFromX(x)
	end))

	trackConn(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromX(input.Position.X)
		end
	end))

	trackConn(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	trackConn(container.MouseWheelForward:Connect(function()
		setValue(currentVal + 5, false)
	end))

	trackConn(container.MouseWheelBackward:Connect(function()
		setValue(currentVal - 5, false)
	end))

	trackConn(minusBtn.MouseButton1Click:Connect(function()
		local step = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 25 or 5
		setValue(currentVal - step, false)
	end))

	trackConn(plusBtn.MouseButton1Click:Connect(function()
		local step = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 25 or 5
		setValue(currentVal + step, false)
	end))

	trackConn(inputBox.FocusLost:Connect(function()
		local num = tonumber(inputBox.Text)
		if num then
			setValue(num, false)
		else
			inputBox.Text = tostring(currentVal)
		end
	end))

	setValue(currentVal, false)
end

