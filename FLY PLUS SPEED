		mainFrame.Size = MINI_SIZE
		titleLabel.Text = "FLY / SPEED / NOCLIP"
		miniBtn.Text = "+"
	else
		mainFrame.Size = FULL_SIZE
		titleLabel.Text = "FLY / SPEED / NOCLIP / JUMP"
		miniBtn.Text = "-"
	end
end))

-- リスポーン時処理
trackConn(player.CharacterAdded:Connect(function(char)
	stopFlying(flyToggleBtn)
	table.clear(savedCanCollide)
	local humanoid = char:WaitForChild("Humanoid", 5)
	if humanoid then
		humanoid.WalkSpeed = getTargetWalkSpeed()
	end
	if noclipEnabled then
		setNoclip(true, noclipToggleBtn)
	end
end))

setupInfiniteJump()
applyWalkSpeed(true)
startSpeedWatchLoop()
