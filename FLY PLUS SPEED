-- 空中ジャンプ（0.14秒間 Heartbeat で上向き速度を維持して打ち消されにくくする）
local function performAirJump()
	if not infJumpEnabled or flying then return end
	if UserInputService:GetFocusedTextBox() then return end

	local now = os.clock()
	if now - lastJumpTime < JUMP_COOLDOWN then return end

	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp then return end

	local state = humanoid:GetState()
	if state == Enum.HumanoidStateType.Dead or state == Enum.HumanoidStateType.Seated then
		return
	end

	if humanoid.PlatformStand then
		humanoid.PlatformStand = false
	end

	lastJumpTime = now
	jumpBoostUntil = now + 0.14

	local v = hrp.AssemblyLinearVelocity
	hrp.AssemblyLinearVelocity = Vector3.new(v.X, JUMP_POWER, v.Z)
	humanoid.Jump = true
	pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end)
end

-- 押し上げ維持ループ
trackConn(RunService.Heartbeat:Connect(function()
	if not infJumpEnabled or flying then return end
	if os.clock() <= jumpBoostUntil then
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp and hrp.Parent then
			local v = hrp.AssemblyLinearVelocity
			if v.Y < JUMP_POWER then
				hrp.AssemblyLinearVelocity = Vector3.new(v.X, JUMP_POWER, v.Z)
			end
		end
	end
end))

-- PC Spaceキー＆スマホ JumpRequest 両対応
local function setupInfiniteJump()
	if jumpRequestConn then
		jumpRequestConn:Disconnect()
		jumpRequestConn = nil
	end
	if inputBeganConn then
		inputBeganConn:Disconnect()
		inputBeganConn = nil
	end

	jumpRequestConn = UserInputService.JumpRequest:Connect(function()
		if infJumpEnabled and not flying then
			performAirJump()
		end
	end)

	inputBeganConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not infJumpEnabled or flying then return end
		if UserInputService:GetFocusedTextBox() then return end
		if input.KeyCode == Enum.KeyCode.Space then
			performAirJump()
		end
	end)
end

-- 目標WalkSpeedを取得（ONなら設定値、OFFなら16）
local function getTargetWalkSpeed()
	return speedEnabled and walkSpeed or DEFAULT_WALK_SPEED
end

-- 現在のWalkSpeed状態（ONなら設定値、OFFなら16）を適用
local function applyWalkSpeed(force)
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local target = getTargetWalkSpeed()
		if force or humanoid.WalkSpeed ~= target then
			humanoid.WalkSpeed = target
		end
	end
end

