-- 0.2秒ごとにWalkSpeedを監視し、ズレていれば再適用するループ
local function startSpeedWatchLoop()
	if speedWatchThread then
		task.cancel(speedWatchThread)
		speedWatchThread = nil
	end

	speedWatchThread = task.spawn(function()
		while screenGui and screenGui.Parent do
			task.wait(SPEED_CHECK_INTERVAL)
			applyWalkSpeed(false)
		end
	end)
end

-- NoClip適用／解除
local function restoreCollision()
	for part, oldVal in pairs(savedCanCollide) do
		if part and part.Parent and part:IsA("BasePart") then
			part.CanCollide = oldVal
		end
	end
	table.clear(savedCanCollide)
end

local function setNoclip(state, btnRef)
	noclipEnabled = state
	if btnRef then
		if noclipEnabled then
			btnRef.Text = "NoClip: ON"
			btnRef.BackgroundColor3 = Color3.fromRGB(55, 175, 105)
		else
			btnRef.Text = "NoClip: OFF"
			btnRef.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
		end
	end

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	if not noclipEnabled then
		restoreCollision()
		return
	end

	noclipConnection = RunService.Stepped:Connect(function()
		local char = player.Character
		if not char then return end
		for _, desc in ipairs(char:GetDescendants()) do
			if desc:IsA("BasePart") then
				if savedCanCollide[desc] == nil then
					savedCanCollide[desc] = desc.CanCollide
				end
				desc.CanCollide = false
			end
		end
	end)
end

