-- 2. 設定・状態変数
local targetUserId = nil
local renderConnection = nil
local offsetY = -4.5
local STEP = 0.5
local lookAngleX = -90

local RETREAT_HP_RATIO = 0.30
local RETURN_HP_RATIO = 0.90
local HIGH_SKY_OFFSET_Y = 1000

local isRetreating = false
local isRescueEnabled = true
local isHeightLocked = false -- 高さ固定追尾の状態フラグ
local lockedY = nil -- 固定するY座標を保持する変数

local function updateDistLabel()
    distLabel.Text = string.format("高さ: %.1f", offsetY)
end

closerBtn.MouseButton1Click:Connect(function()
    offsetY = offsetY + STEP
    updateDistLabel()
end)

fartherBtn.MouseButton1Click:Connect(function()
    offsetY = offsetY - STEP
    updateDistLabel()
end)

lookToggleBtn.MouseButton1Click:Connect(function()
    if lookAngleX == -90 then
        lookAngleX = 90
        lookToggleBtn.Text = "向き: 上向き (見上げ)"
        lookToggleBtn.BackgroundColor3 = Color3.fromRGB(110, 80, 150)
    else
        lookAngleX = -90
        lookToggleBtn.Text = "向き: 下向き (見下ろし)"
        lookToggleBtn.BackgroundColor3 = Color3.fromRGB(70, 90, 140)
    end
end)

rescueToggleBtn.MouseButton1Click:Connect(function()
    isRescueEnabled = not isRescueEnabled
    if isRescueEnabled then
        rescueToggleBtn.Text = "低HP退避機能: ON"
        rescueToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 90)
    else
        rescueToggleBtn.Text = "低HP退避機能: OFF"
        rescueToggleBtn.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
        isRetreating = false
    end
end)

-- ★高さ固定追尾ボタンの切り替え処理
lockHeightToggleBtn.MouseButton1Click:Connect(function()
    isHeightLocked = not isHeightLocked
    local myChar = localPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    if isHeightLocked then
        if myHRP then
            -- 現在の高さ（Y座標）を記憶
            lockedY = myHRP.Position.Y
        end
        lockHeightToggleBtn.Text = "高さ固定追尾: ON"
        lockHeightToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 30)
    else
        lockHeightToggleBtn.Text = "高さ固定追尾: OFF"
        lockHeightToggleBtn.BackgroundColor3 = Color3.fromRGB(140, 90, 40)
        lockedY = nil
    end
end)

local function stopFollowing()
    targetUserId = nil
    isRetreating = false
    isHeightLocked = false
    lockedY = nil
    lockHeightToggleBtn.Text = "高さ固定追尾: OFF"
    lockHeightToggleBtn.BackgroundColor3 = Color3.fromRGB(140, 90, 40)
    titleLabel.Text = "Under TP (高さ固定追尾対応)"
    titleLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 25)

    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end

    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        local pos = hrp.Position
        local _, yRot, _ = hrp.CFrame:ToOrientation()
        hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, yRot, 0)
    end
end

local function startFollowing(targetPlayer)
    stopFollowing()
    targetUserId = targetPlayer.UserId

    renderConnection = RunService.Heartbeat:Connect(function()
        if not targetUserId then return end

        local target = Players:GetPlayerByUserId(targetUserId)

        if not target then
            stopFollowing()
            return
        end

        local myChar = localPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")

        local targetChar = target.Character
        local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

        if not myHRP or not targetHRP then
            return
        end

        local currentOffsetY = offsetY

        if isRescueEnabled then
            local hpRatio = 1
            if myHumanoid and myHumanoid.MaxHealth > 0 then
                hpRatio = myHumanoid.Health / myHumanoid.MaxHealth
            end

            if hpRatio <= 0 then
                isRetreating = false
            elseif not isRetreating and hpRatio <= RETREAT_HP_RATIO then
                isRetreating = true
            elseif isRetreating and hpRatio >= RETURN_HP_RATIO then
                isRetreating = false
            end

            if isRetreating then
                currentOffsetY = HIGH_SKY_OFFSET_Y
                local hpPercent = math.floor(hpRatio * 100)
                titleLabel.Text = string.format("【退避中 HP:%d%%】90%%待機", hpPercent)
                titleLabel.BackgroundColor3 = Color3.fromRGB(180, 90, 20)
            else
                titleLabel.Text = "追跡中: " .. target.DisplayName
                titleLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
            end
        else
            titleLabel.Text = "追跡中: " .. target.DisplayName
            titleLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        end

        -- 通常の位置計算
        local targetPos = targetHRP.Position
        local finalPos = targetPos + Vector3.new(0, currentOffsetY, 0)

        -- ★高さ固定追尾がON、かつ退避中でない場合、Y座標（高さ）をONにした時点の高さに固定する
        if isHeightLocked and lockedY and not isRetreating then
            finalPos = Vector3.new(targetPos.X, lockedY, targetPos.Z)
        end

        myHRP.CFrame = CFrame.new(finalPos) * CFrame.Angles(math.rad(lookAngleX), 0, 0)
        myHRP.AssemblyLinearVelocity = Vector3.zero
    end)
end

-- 3. プレイヤー一覧の更新
local function updatePlayerList()
    for _, child in ipairs(playerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local myChar = localPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    local searchText = string.lower(searchBox.Text)
    local isSearching = (searchText ~= "")

    local playersList = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local displayName = string.lower(player.DisplayName)
            local name = string.lower(player.Name)
            
            if not isSearching or string.find(displayName, searchText) or string.find(name, searchText) then
                table.insert(playersList, player)
            end
        end
    end

    table.sort(playersList, function(a, b)
        local successA, isAFriend = pcall(function()
            return localPlayer:IsFriendsWith(a.UserId)
        end)
        local successB, isBFriend = pcall(function()
            return localPlayer:IsFriendsWith(b.UserId)
        end)

        isAFriend = successA and isAFriend
        isBFriend = successB and isBFriend

        if isAFriend ~= isBFriend then
            return not isAFriend
        end

        if isSearching then
            return a.Name < b.Name
        else
            local charA = a.Character
            local hrpA = charA and charA:FindFirstChild("HumanoidRootPart")
            local charB = b.Character
            local hrpB = charB and charB:FindFirstChild("HumanoidRootPart")

            local distA = hrpA and myHRP and (myHRP.Position - hrpA.Position).Magnitude or math.huge
            local distB = hrpB and myHRP and (myHRP.Position - hrpB.Position).Magnitude or math.huge

            return distA < distB
        end
    end)

    for _, player in ipairs(playersList) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -6, 0, 32)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        local distText = ""
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if myHRP and hrp then
            local distance = math.floor((myHRP.Position - hrp.Position).Magnitude)
            distText = string.format(" (%dm)", distance)
        end

        local success, isFriend = pcall(function()
            return localPlayer:IsFriendsWith(player.UserId)
        end)
        local friendTag = (success and isFriend) and " [フレンド]" or ""

        btn.Text = player.DisplayName .. distText .. friendTag .. " (@" .. player.Name .. ")"
        btn.Font = Enum.Font.SourceSans
        btn.TextSize = 14

        if player.UserId == targetUserId then
            btn.BackgroundColor3 = Color3.fromRGB(50, 140, 80)
        else
            btn.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
        end

        btn.Parent = playerList

        btn.MouseButton1Click:Connect(function()
            startFollowing(player)
            updatePlayerList()
        end)
    end
end

searchBox:GetPropertyChangedSignal("Text"):Connect(updatePlayerList)

stopButton.MouseButton1Click:Connect(stopFollowing)

Players.PlayerAdded:Connect(updatePlayerList)

Players.PlayerRemoving:Connect(function(leavingPlayer)
    if leavingPlayer.UserId == targetUserId then
        stopFollowing()
    end

    updatePlayerList()
end)

task.spawn(function()
    while screenGui.Parent do
        updatePlayerList()
        task.wait(1)
    end
end)
