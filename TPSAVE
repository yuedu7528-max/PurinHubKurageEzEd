-- セーブファイルの設定（ゲームごとに分けて保存したい場合は PlaceId を含めるのがおすすめです）
local FolderName = "TeleportSaves"
local FileName = FolderName .. "/SavedLocations_" .. tostring(game.PlaceId) .. ".json"

-- ファイル保存機能のチェックと初期化
local hasFileSystem = (writefile ~= nil and readfile ~= nil and isfile ~= nil)
if hasFileSystem and makefolder ~= nil and isfolder ~= nil then
    if not isfolder(FolderName) then
        makefolder(FolderName)
    end
end

-- 保存データの管理テーブル
local SavedLocations = {}

-- データのセーブ関数
local function SaveData()
    if not hasFileSystem then return end
    local success, encoded = pcall(function()
        return HttpService:JSONEncode(SavedLocations)
    end)
    if success then
        writefile(FileName, encoded)
    end
end

-- データのロード関数
local function LoadData()
    if not hasFileSystem or not isfile(FileName) then return end
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(FileName))
    end)
    if success and type(decoded) == "table" then
        SavedLocations = decoded
    end
end

