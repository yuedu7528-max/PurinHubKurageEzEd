-- リストのUIを更新・再描画する関数
local function RefreshList()
    -- 既存のアイテムをクリア
    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    -- 保存データからボタンを生成
    for index, locData in ipairs(SavedLocations) do
        local ItemFrame = Instance.new("Frame")
        ItemFrame.Size = UDim2.new(1, 0, 0, 32)
        ItemFrame.BackgroundColor3 = Color3.fromRGB(38, 38, 45)
        ItemFrame.Parent = ScrollFrame
        Instance.new("UICorner", ItemFrame).CornerRadius = UDim.new(0, 5)

        -- テレポート実行ボタン
        local TpBtn = Instance.new("TextButton")
        TpBtn.Size = UDim2.new(1, -36, 1, 0)
        TpBtn.Position = UDim2.new(0, 0, 0, 0)
        TpBtn.BackgroundTransparency = 1
        TpBtn.Text = "  " .. locData.name
        TpBtn.TextColor3 = Color3.fromRGB(230, 230, 240)
        TpBtn.Font = Enum.Font.GothamSemibold
        TpBtn.TextSize = 13
        TpBtn.TextXAlignment = Enum.TextXAlignment.Left
        TpBtn.TextTruncate = Enum.TextTruncate.AtEnd
        TpBtn.Parent = ItemFrame

        TpBtn.MouseButton1Click:Connect(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- 保存された座標へテレポート
                hrp.CFrame = CFrame.new(locData.x, locData.y, locData.z)
            end
        end)

        -- 削除ボタン
        local DelBtn = Instance.new("TextButton")
        DelBtn.Size = UDim2.new(0, 26, 0, 26)
        DelBtn.Position = UDim2.new(1, -29, 0, 3)
        DelBtn.BackgroundColor3 = Color3.fromRGB(180, 55, 55)
        DelBtn.Text = "削除"
        DelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        DelBtn.Font = Enum.Font.GothamBold
        DelBtn.TextSize = 10
        DelBtn.Parent = ItemFrame
        Instance.new("UICorner", DelBtn).CornerRadius = UDim.new(0, 4)

        DelBtn.MouseButton1Click:Connect(function()
            table.remove(SavedLocations, index)
            SaveData()
            RefreshList()
        end)
    end
end

-- 追加ボタンの処理
AddBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local locName = NameInput.Text
    if locName == "" or locName:match("^%s*$") then
        locName = "場所 #" .. (#SavedLocations + 1)
    end

    local pos = hrp.Position
    table.insert(SavedLocations, {
        name = locName,
        x = pos.X,
        y = pos.Y,
        z = pos.Z
    })

    NameInput.Text = ""
    SaveData()
    RefreshList()
end)

